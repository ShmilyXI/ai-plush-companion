ZIXUAN_CONTRACT_VERSION=zixuan-cutover-v1
ZIXUAN_RELEASE_VERSION=2.2.7
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_DRUID_URL=jdbc:mysql://127.0.0.1:3306/zixuan_esp32_server
SPRING_DATASOURCE_DRUID_USERNAME=zixuan
SPRING_DATASOURCE_DRUID_PASSWORD=
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
MANAGER_API_URL=http://127.0.0.1:8002
ZIXUAN_RUNTIME_HTTP_URL=http://127.0.0.1:8003
ZIXUAN_RUNTIME_WEBSOCKET_URL=ws://127.0.0.1:8000/zixuan/v1/
ZIXUAN_VISION_EXPLAIN_URL=http://127.0.0.1:8003/mcp/vision/explain
SERVER_SECRET=
ZIXUAN_MQTT_UPLINK_TOPIC=zixuan/device-server
ZIXUAN_MQTT_DOWNLINK_PREFIX=zixuan/devices/p2p/
TENCENTDB_MEMORY_CORE_KEY=
TENCENTDB_MEMORY_MODEL_PROXY_KEY=

# 让 manager-api 信任内网反向代理和 companion-web 转发的来源地址。
# 对外提供网页端手机号登录时必须设置，否则所有用户共用同一个短信发送额度。见 docs/web-sign-in.md。
SERVER_FORWARD_HEADERS_STRATEGY=native
