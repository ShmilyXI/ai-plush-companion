# 生产镜像，仅包含应用代码
FROM ghcr.io/xinnan-tech/xiaozhi-esp32-server:server-base

WORKDIR /opt/zixuan-server

COPY main/zixuan-server .
COPY main/shared ./server/main/shared
RUN test -d ./models/wake_word/fst \
    && test -d ./models/wake_word/mn7_cn \
    && test -f ./models/wake_word/fst/commands_cn.txt
RUN touch ./server/__init__.py ./server/main/__init__.py \
    && pip install --no-cache-dir pypinyin==0.54.0

# 启动应用
CMD ["python", "app.py"]
