MANAGER_API_BASE_URL=http://127.0.0.1:8002/zixuan
NEXT_PUBLIC_CONSOLE_URL=http://127.0.0.1:8001
# 管理台的地址，可以写多个，用逗号隔开。管理台嵌入网页端时只接受这些地址发来的登录交接。
NEXT_PUBLIC_CONSOLE_ORIGIN=http://127.0.0.1:8001,http://localhost:8001
# Set this when manager-api returns an internal runtime host that browsers cannot reach.
PUBLIC_RUNTIME_WS_ORIGIN=
# 页面对外使用的域名，多个用逗号分隔。经这些域名打开时，对话的实时连接走同域名的 wss（由反向代理按 /api/v1/conversations/ 转给对话服务）。
PUBLIC_SITE_HOSTS=
