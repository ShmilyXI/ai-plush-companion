{
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi-s3cam",
            "sdkconfig_append": [
                "CONFIG_OTA_URL=\"http://192.168.0.102:8002/zixuan/ota/\"",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m.csv\"",
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_LCD_ST7789_240X320=y",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"ni hao zi xuan\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"你好紫萱\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_SR_MN_EN_NONE=y"
            ]
        }
    ]
